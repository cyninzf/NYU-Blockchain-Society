DATABASE_URL=
# Email via Resend (sending domain nyublockchainsociety.com).
RESEND_API_KEY=
REPLY_TO_EMAIL=
# Optional: daily send limit (Resend free plan: 100).
EMAIL_DAILY_LIMIT=
# Admin and member magic-link sign-in: signs sessions and link tokens.
AUTH_SECRET=
# Always a super admin (the recovery key): can never be removed, demoted or locked out.
SUPER_ADMIN_EMAIL=
# Optional: signs join-form tokens and hashes IPs for rate limiting. Falls back to DATABASE_URL.
FORM_SECRET=
# Daily invite run (vercel.json cron): Vercel sends it as a bearer token.
CRON_SECRET=
# Resend webhook signing secret (whsec_...) for bounces and complaints.
RESEND_WEBHOOK_SECRET=
# Error monitoring (Sentry, round 16). Without the DSNs Sentry stays off. Both are the project's DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build time only: upload source maps (readable stack traces). All three or none.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
