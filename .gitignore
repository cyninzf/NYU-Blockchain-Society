# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (only the empty template is committed)
.env
.env*.local
.env*
!.env.example

# member data and test fixtures: never commit spreadsheets or exports, anywhere.
# Local test files go in fixtures/local/ (ignored as a whole).
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
/exports
/fixtures/local/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated at build time by scripts/media-kit.mjs
/public/media-kit
